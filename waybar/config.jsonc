{
	"layer": "top",
  "height": 30,
	"modules-left": ["sway/workspaces", "sway/mode", "sway/window"],
	"modules-center": ["clock"],
	"modules-right": [
		"custom/powerline-custom-pacman",
		"custom/pacman",
		"custom/powerline-pulseaudio",
		"pulseaudio",
		"custom/powerline-network",
		"network",
		"custom/powerline-power-profiles-daemon",
		"power-profiles-daemon",
		"custom/powerline-cpu",
		"cpu",
		"custom/powerline-memory",
		"memory",
		"custom/powerline-temperature",
		"temperature",
		"custom/powerline-backlight",
		"backlight",
		"custom/powerline-sway-language",
		"sway/language",
		"custom/powerline-battery",
		"battery",
		"custom/powerline-tray",
		"tray"
	],
	// Modules Left
	"sway/workspaces": {
		"format": "{icon}",
		"format-icons": {
			"1": "",
			"2": "",
			"3": "",
			"4": "󰨞",
			"5": "",
			"6": "󱛜",
			"7": "",
			"8": "󰉋",
			"9": "",
			"default": ""
		}
	},
    "sway/mode": {
	    "format": "<span style=\"italic\">{}</span>"
	},
  // Modules Center
	"clock": {
		"format": "{:%a %d/%m/%y  %I:%M %p}",
		"tooltip": false
	},
	// Modules Right
	"custom/powerline-custom-pacman": {
		"format": "",
		"tooltip": false
	},
	"custom/pacman": {
		"format": "{icon}{}",
		"return-type": "json",
		"format-icons": {
			"pending-updates": " ",
			"updated": ""
		},
		"exec-if": "which waybar-updates",
		"exec": "waybar-updates",
		"on-click": "kitty -e sudo pacman -Syu"
	},
	"custom/powerline-pulseaudio": {
		"format": "",
		"tooltip": false
	},
	"pulseaudio": {
		"format": "{volume}% {icon}",
		"format-bluetooth": "{volume}% {icon}",
		"format-bluetooth-muted": "󰂲 {icon}",
		"format-muted": "󰝟",
		"format-icons": {
			"headphone": "",
			"hands-free": "",
			"headset": "󰋎",
			"phone": "",
			"portable": "",
			"car": "",
			"default": ["", "", ""]
		},
		"on-click": "pavucontrol"
	},
	"custom/powerline-network": {
		"format": "",
		"tooltip": false
	},
	"network": {
		"format-wifi": "{signalStrength}% ",
		"format-ethernet": "",
		"tooltip-format": "{essid} ",
		"format-disconnected": "Disconnected ⚠"
	},
	"custom/powerline-power-profiles-daemon": {
		"format": "",
		"tooltip": false
	},
	"power-profiles-daemon": {
	  "format": "{icon}",
	  "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
	  "tooltip": true,
	  "format-icons": {
	    "default": "",
	    "performance": "",
	    "balanced": "",
	    "power-saver": ""
	  }
	},
	"custom/powerline-cpu": {
		"format": "",
		"tooltip": false
	},
	"cpu": {
		"format": "{usage}% ",
		"tooltip": false
	},
	"custom/powerline-memory": {
		"format": "",
		"tooltip": false
	},
	"memory": {
		"format": "{}% "
	},
	"custom/powerline-temperature": {
		"format": "",
		"tooltip": false
	},
	"temperature": {
		"critical-threshold": 80,
		"format": "{temperatureC}°C {icon}",
		"format-icons": ["", "", ""]
	},
	"custom/powerline-backlight": {
		"format": "",
		"tooltip": false
	},
	"backlight": {
		"tooltip": false,
		"format": "{percent}% {icon}",
		"format-icons": ["", "", "", "", "", "", "", "", ""]
	},
	"custom/powerline-sway-language": {
		"format": "",
		"tooltip": false
	},
	"custom/powerline-battery": {
		"format": "",
		"tooltip": false
	},
	"battery": {
	    "states": {
	        "warning": 30,
	        "critical": 15
	    },
	    "format": "{capacity}% {icon}",
	    "format-full": "{capacity}% {icon}",
	    "format-charging": "{capacity}% ",
	    "format-plugged": "{capacity}% ",
	    "format-alt": "{time} {icon}",
	    "format-icons": ["", "", "", "", ""]
	},
	"custom/powerline-tray": {
		"format": "",
		"tooltip": false
	},
	"tray": {
		// "icon-size": 21,
		"spacing": 10
	}
}
